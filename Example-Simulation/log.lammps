# Velocities

velocity            all create ${T} ${vseed} mom yes rot no
velocity            all create 300 ${vseed} mom yes rot no
velocity            all create 300 123 mom yes rot no

# NPT dynamics

reset_timestep      0
timestep            1.0
thermo_style        custom time temp press etotal ke pe ebond eangle edihed eimp evdwl etail ecoul elong
thermo              0

fix                 0 all shake 1.0e-6 50 0 b 1
Finding SHAKE clusters ...
    4000 = # of size 2 clusters
       0 = # of size 3 clusters
       0 = # of size 4 clusters
       0 = # of frozen angles
  find clusters CPU = 0.002 seconds
fix                 1 all npt temp ${T} ${T} $(100.0*dt) iso ${P} ${P} $(1000.0*dt) nreset 20000
fix                 1 all npt temp 300 ${T} $(100.0*dt) iso ${P} ${P} $(1000.0*dt) nreset 20000
fix                 1 all npt temp 300 300 $(100.0*dt) iso ${P} ${P} $(1000.0*dt) nreset 20000
fix                 1 all npt temp 300 300 100 iso ${P} ${P} $(1000.0*dt) nreset 20000
fix                 1 all npt temp 300 300 100 iso 197.38 ${P} $(1000.0*dt) nreset 20000
fix                 1 all npt temp 300 300 100 iso 197.38 197.38 $(1000.0*dt) nreset 20000
fix                 1 all npt temp 300 300 100 iso 197.38 197.38 1000 nreset 20000
fix                 2 all ave/time 1 1000000 1000000 c_thermo_temp c_thermo_press v_density v_vol v_lx file run-averages.txt
fix                 3 all ave/time 1000 1 1000 c_thermo_temp c_thermo_press v_density v_vol v_lx v_cpuremain file run-instantaneous.txt
dump                dmp all atom 100000 dump.lammpstrj

run                 2000000
