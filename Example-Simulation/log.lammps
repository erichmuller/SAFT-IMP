LAMMPS (2 Sep 2026)
  using 1 OpenMP thread(s) per MPI task
# Variables
variable T equal 300
variable PMPa equal 20

variable vseed equal 123
variable molranseed equal 123
variable molseed equal 123

variable mol_num equal 4000
variable box_length equal 74.28

# ---- molecular input -------------------------------------------------------
variable mol_mass equal 44.01
variable m      equal 2             # segments per molecule (integer in these fits)
variable sigma  equal 2.85109       # segment diameter            [Angstrom]
variable epsK   equal 156.873       # dispersion well depth       [K]
variable lr     equal 10.6993       # repulsive exponent  (MUST exceed the largest
                                    #   active attractive exponent: 6 with a dipole,
                                    #   10 once the quadrupole term is switched on)
variable la     equal 6.00          # attractive (dispersion) exponent; 6 for SAFT-VR IMP fits
variable muD    equal 0.0           # molecular dipole moment     [D]
variable QDA    equal 1.7320        # molecular quadrupole moment [D*Angstrom]; 0 = plain SAFT-gamma Mie
variable alpha  equal 0.0           # molecular polarizability    [Angstrom^3]

# ---- physical constants ----------------------------------------------------
variable kb     equal 0.0019872067  # kcal/(mol*K)  -> energy unit per kelvin

variable segment_mass equal ${mol_mass}/${m}
variable segment_mass equal 44.01/${m}
variable segment_mass equal 44.01/2
variable P          equal ${PMPa}*9.869
variable P          equal 20*9.869

# derived coefficients
# (1 D)^2/(4*pi*eps0*kB) = 7242.97 K*Angstrom^3; times kb -> kcal/mol*Angstrom^3 per D^2.
# The moments are divided by m because they are distributed over the m segments.
variable D2K     equal 7242.970516

variable Cmie    equal ${lr}/(${lr}-${la})*(${lr}/${la})^(${la}/(${lr}-${la}))
variable Cmie    equal 10.6993/(${lr}-${la})*(${lr}/${la})^(${la}/(${lr}-${la}))
variable Cmie    equal 10.6993/(10.6993-${la})*(${lr}/${la})^(${la}/(${lr}-${la}))
variable Cmie    equal 10.6993/(10.6993-6)*(${lr}/${la})^(${la}/(${lr}-${la}))
variable Cmie    equal 10.6993/(10.6993-6)*(10.6993/${la})^(${la}/(${lr}-${la}))
variable Cmie    equal 10.6993/(10.6993-6)*(10.6993/6)^(${la}/(${lr}-${la}))
variable Cmie    equal 10.6993/(10.6993-6)*(10.6993/6)^(6/(${lr}-${la}))
variable Cmie    equal 10.6993/(10.6993-6)*(10.6993/6)^(6/(10.6993-${la}))
variable Cmie    equal 10.6993/(10.6993-6)*(10.6993/6)^(6/(10.6993-6))
variable epsreal equal ${epsK}*${kb}
variable epsreal equal 156.873*${kb}
variable epsreal equal 156.873*0.0019872067
variable beta    equal 1/(${kb}*${T})
variable beta    equal 1/(0.0019872067*${T})
variable beta    equal 1/(0.0019872067*300)
variable mu2     equal ${D2K}*${kb}*${muD}*${muD}/${m}     # mu_hat^2  [kcal/mol*A^3]
variable mu2     equal 7242.970516*${kb}*${muD}*${muD}/${m}     
variable mu2     equal 7242.970516*0.0019872067*${muD}*${muD}/${m}     
variable mu2     equal 7242.970516*0.0019872067*0*${muD}/${m}     
variable mu2     equal 7242.970516*0.0019872067*0*0/${m}     
variable mu2     equal 7242.970516*0.0019872067*0*0/2     
variable Q2      equal ${D2K}*${kb}*${QDA}*${QDA}/${m}     # Q_hat^2   [kcal/mol*A^5]
variable Q2      equal 7242.970516*${kb}*${QDA}*${QDA}/${m}     
variable Q2      equal 7242.970516*0.0019872067*${QDA}*${QDA}/${m}     
variable Q2      equal 7242.970516*0.0019872067*1.732*${QDA}/${m}     
variable Q2      equal 7242.970516*0.0019872067*1.732*1.732/${m}     
variable Q2      equal 7242.970516*0.0019872067*1.732*1.732/2     
variable mumuc   equal ${mu2}*${mu2}/3                     # [(kcal/mol)^2*A^6]
variable mumuc   equal 0*${mu2}/3                     
variable mumuc   equal 0*0/3                     
variable muQc    equal ${mu2}*${Q2}                        # [(kcal/mol)^2*A^8]
variable muQc    equal 0*${Q2}                        
variable muQc    equal 0*21.5886526973472                        
variable QQc     equal 1.4*${Q2}*${Q2}                     # [(kcal/mol)^2*A^10]
variable QQc     equal 1.4*21.5886526973472*${Q2}                     
variable QQc     equal 1.4*21.5886526973472*21.5886526973472                     

# Initialisation

units               real
boundary            p p p
atom_style          full
newton              on

pair_style          lepton 20.0
bond_style          harmonic

special_bonds       lj 0.0 1.0 1.0

region startbox block 0 ${box_length} 0 ${box_length} 0 ${box_length}
region startbox block 0 74.28 0 ${box_length} 0 ${box_length}
region startbox block 0 74.28 0 74.28 0 ${box_length}
region startbox block 0 74.28 0 74.28 0 74.28
create_box 1 startbox bond/types 1                       angle/types 0                       dihedral/types 0                       extra/bond/per/atom 10                       extra/angle/per/atom 10                       extra/dihedral/per/atom 10                       extra/special/per/atom 20
Created orthogonal box = (0 0 0) to (74.28 74.28 74.28)
  4 by 4 by 8 MPI processor grid

mass            1 ${segment_mass}
mass            1 22.005
pair_coeff      1 1 C*eps*((sig/r)^lamr-(sig/r)^lama)-beta*(mumuc/r^6+muQc/r^8+QQc/r^10);C=${Cmie};eps=${epsreal};sig=${sigma};lamr=${lr};lama=${la};beta=${beta};mumuc=${mumuc};muQc=${muQc};QQc=${QQc}
pair_coeff      1 1 C*eps*((sig/r)^lamr-(sig/r)^lama)-beta*(mumuc/r^6+muQc/r^8+QQc/r^10);C=4.76492497123718;eps=${epsreal};sig=${sigma};lamr=${lr};lama=${la};beta=${beta};mumuc=${mumuc};muQc=${muQc};QQc=${QQc}
pair_coeff      1 1 C*eps*((sig/r)^lamr-(sig/r)^lama)-beta*(mumuc/r^6+muQc/r^8+QQc/r^10);C=4.76492497123718;eps=0.3117390766491;sig=${sigma};lamr=${lr};lama=${la};beta=${beta};mumuc=${mumuc};muQc=${muQc};QQc=${QQc}
pair_coeff      1 1 C*eps*((sig/r)^lamr-(sig/r)^lama)-beta*(mumuc/r^6+muQc/r^8+QQc/r^10);C=4.76492497123718;eps=0.3117390766491;sig=2.85109;lamr=${lr};lama=${la};beta=${beta};mumuc=${mumuc};muQc=${muQc};QQc=${QQc}
pair_coeff      1 1 C*eps*((sig/r)^lamr-(sig/r)^lama)-beta*(mumuc/r^6+muQc/r^8+QQc/r^10);C=4.76492497123718;eps=0.3117390766491;sig=2.85109;lamr=10.6993;lama=${la};beta=${beta};mumuc=${mumuc};muQc=${muQc};QQc=${QQc}
pair_coeff      1 1 C*eps*((sig/r)^lamr-(sig/r)^lama)-beta*(mumuc/r^6+muQc/r^8+QQc/r^10);C=4.76492497123718;eps=0.3117390766491;sig=2.85109;lamr=10.6993;lama=6;beta=${beta};mumuc=${mumuc};muQc=${muQc};QQc=${QQc}
pair_coeff      1 1 C*eps*((sig/r)^lamr-(sig/r)^lama)-beta*(mumuc/r^6+muQc/r^8+QQc/r^10);C=4.76492497123718;eps=0.3117390766491;sig=2.85109;lamr=10.6993;lama=6;beta=1.67739638424797;mumuc=${mumuc};muQc=${muQc};QQc=${QQc}
pair_coeff      1 1 C*eps*((sig/r)^lamr-(sig/r)^lama)-beta*(mumuc/r^6+muQc/r^8+QQc/r^10);C=4.76492497123718;eps=0.3117390766491;sig=2.85109;lamr=10.6993;lama=6;beta=1.67739638424797;mumuc=0;muQc=${muQc};QQc=${QQc}
pair_coeff      1 1 C*eps*((sig/r)^lamr-(sig/r)^lama)-beta*(mumuc/r^6+muQc/r^8+QQc/r^10);C=4.76492497123718;eps=0.3117390766491;sig=2.85109;lamr=10.6993;lama=6;beta=1.67739638424797;mumuc=0;muQc=0;QQc=${QQc}
pair_coeff      1 1 C*eps*((sig/r)^lamr-(sig/r)^lama)-beta*(mumuc/r^6+muQc/r^8+QQc/r^10);C=4.76492497123718;eps=0.3117390766491;sig=2.85109;lamr=10.6993;lama=6;beta=1.67739638424797;mumuc=0;muQc=0;QQc=652.497895401347
bond_coeff      1 10000.0 ${sigma}
bond_coeff      1 10000.0 2.85109

molecule        smol CO2.txt
Read molecule template smol:
# CO2 molecule.
  1 molecules
  0 fragments
  0 bodies
  2 atoms with max type 1
  1 bonds with max type 1
  0 angles with max type 0
  0 dihedrals with max type 0
  0 impropers with max type 0
create_atoms 0 random ${mol_num} ${molranseed} NULL overlap 2.0 mol smol ${molseed} units box maxtry 10000
create_atoms 0 random 4000 ${molranseed} NULL overlap 2.0 mol smol ${molseed} units box maxtry 10000
create_atoms 0 random 4000 123 NULL overlap 2.0 mol smol ${molseed} units box maxtry 10000
create_atoms 0 random 4000 123 NULL overlap 2.0 mol smol 123 units box maxtry 10000
Created 8000 atoms
  using box units in orthogonal box = (0 0 0) to (74.28 74.28 74.28)
  create_atoms CPU = 0.248 seconds

neigh_modify        one 6000

variable            cpuremain equal cpuremain
variable            vol equal vol
variable            density equal density
variable            lx equal lx

# Minimisation

thermo_style        custom fmax fnorm press etotal ke pe ebond eangle edihed eimp evdwl etail ecoul elong
thermo              100

min_style           cg
min_modify          dmax 0.05
minimize            1.0e-4 1.0e-6 2000 20000
